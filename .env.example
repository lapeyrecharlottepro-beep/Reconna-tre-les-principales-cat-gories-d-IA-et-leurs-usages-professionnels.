# Copier ce fichier en `.env` puis renseigner les valeurs.
# Le fichier .env est ignoré par Git : la clé ne quitte jamais le serveur.

# Clé API OpenAI (obligatoire pour les niveaux 2, 3 et 4)
OPENAI_API_KEY=

# Facultatif : modèle de génération et modèle d'embeddings
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Facultatif : URL d'une API compatible OpenAI (proxy d'entreprise, serveur de test…)
# OPENAI_BASE_URL=

# --- Alternative gratuite, SANS clé API : modèle local avec Ollama (https://ollama.com) ---
# Laisser OPENAI_API_KEY vide et décommenter les trois lignes suivantes :
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b
# OPENAI_EMBEDDING_MODEL=nomic-embed-text

# Port du serveur
PORT=3000

# Facultatif : jeton exigé pour consulter /api/metrics (vide = accès réservé à localhost)
# METRICS_TOKEN=

# Facultatif (niveau 4, outil désactivé par défaut) : webhook n8n
# N8N_WEBHOOK_URL=
